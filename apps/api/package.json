{
  "name": "@a-ponte/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend NestJS (monolito modular, DDD) da Rede Colheita",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node -T src/modules/legacy-import/seed.ts",
    "import:legacy": "ts-node -T src/modules/legacy-import/import-legacy.cli.ts",
    "schedule:materialize": "ts-node -T src/modules/scheduling/materialize.cli.ts",
    "notifications:dispatch": "ts-node -T src/modules/notifications/dispatch.cli.ts",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node -T src/modules/legacy-import/seed.ts"
  },
  "dependencies": {
    "@a-ponte/contracts": "*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.46.1",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
