# =========================================================================
# A PONTE — REDE COLHEITA
# Copie para .env (raiz), apps/api/.env e apps/web/.env.local conforme a seção.
# =========================================================================

# ------------------------- apps/api (NestJS) -----------------------------
NODE_ENV=development
PORT=3333
API_GLOBAL_PREFIX=api
# Interface de escuta. Deixe VAZIO no desenvolvimento: sem host explícito o
# Node escuta em `::` com dual-stack e atende IPv6 e IPv4. Isso importa porque
# `localhost` resolve para ::1 antes de 127.0.0.1, e o fetch do Next.js tentaria
# o ::1 — amarrar em 0.0.0.0 daria ECONNREFUSED ::1:3333 com a API no ar.
# Só preencha (HOST=0.0.0.0) em container sem IPv6.
HOST=
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Postgres do Supabase — USE O SESSION POOLER, não a conexão direta.
#
# A string "Direct connection" (db.SEUPROJETO.supabase.co) resolve apenas em
# IPv6 desde 2024; IPv4 virou add-on pago. Em rede sem IPv6 — o caso da
# maioria das operadoras brasileiras — ela falha com P1001 "Can't reach
# database server", que parece erro de senha e não é.
#
# O Session Pooler fala IPv4 e aguenta DDL, então serve tanto para o
# `prisma migrate` quanto para o container em produção. Copie do painel:
# Project Settings > Database > Connection string > Session pooler.
# Repare que o usuário vira `postgres.SEUPROJETO`, não `postgres`.
#
# connection_limit NÃO É OPCIONAL aqui. O pooler do Supabase aceita 15 conexões
# no total, e o padrão do Prisma é (CPUs x 2 + 1) por processo — numa máquina de
# 8 núcleos são 17, e um único container estoura o limite sozinho. O sintoma é
# "EMAXCONNSESSION: max clients reached in session mode".
# 5 deixa folga para migrations e comandos de linha rodarem em paralelo com a
# API. Suba esse número só se o pool do Supabase for maior no seu plano.
DATABASE_URL=postgresql://postgres.SEUPROJETO:SENHA@aws-0-SUAREGIAO.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=20?schema=public

# Supabase — Project Settings > API
SUPABASE_URL=https://SEUPROJETO.supabase.co
# service_role: NUNCA exponha no frontend. Só o backend usa.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo JWT legado (HS256). Opcional se o projeto já usa chaves assimétricas
# — nesse caso o backend valida pela JWKS de SUPABASE_URL automaticamente.
SUPABASE_JWT_SECRET=
# Bucket de fotos das colheitas (privado)
SUPABASE_STORAGE_BUCKET=colheitas

# Fuso da operação — usado por toda a geração de escala e corte de pendência
APP_TIMEZONE=America/Fortaleza

# Motor de pendência: hora local do corte diário (formato HH:mm)
COMPLIANCE_CUTOFF_TIME=20:00
# Horário local do disparo da escala do dia
SCHEDULE_DISPATCH_TIME=06:30
# Quantos dias à frente as ocorrências da escala são materializadas
SCHEDULE_HORIZON_DAYS=14
# Liga/desliga os jobs agendados (deixe false em máquinas de desenvolvimento)
SCHEDULER_ENABLED=false

# Notificações — driver do canal de WhatsApp.
# console  = só registra no log e no banco (padrão, nada é enviado de verdade)
# webhook  = faz POST do payload num endpoint HTTP seu (Evolution API, n8n, etc.)
NOTIFICATIONS_DRIVER=console
NOTIFICATIONS_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_TOKEN=
# Não envia nada para fora quando true, mesmo com driver=webhook
NOTIFICATIONS_DRY_RUN=true

# Base pública do frontend — entra nos links das mensagens
PUBLIC_WEB_URL=http://localhost:3000

# ------------------------- apps/web (Next.js) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEUPROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3333/api
