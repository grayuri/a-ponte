# =========================================================================
# A PONTE — REDE COLHEITA
# Copie para .env (raiz), apps/api/.env e apps/web/.env.local conforme a seção.
# =========================================================================

# ------------------------- apps/api (NestJS) -----------------------------
NODE_ENV=development
PORT=3333
API_GLOBAL_PREFIX=api
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Postgres do Supabase.
# Use a "Connection string" -> "Transaction pooler" (porta 6543) em produção
# serverless, ou "Session" (5432) para o container do Render/Railway.
DATABASE_URL=postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres?schema=public

# Supabase — Project Settings > API
SUPABASE_URL=https://SEUPROJETO.supabase.co
# service_role: NUNCA exponha no frontend. Só o backend usa.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo JWT legado (HS256). Opcional se o projeto já usa chaves assimétricas
# — nesse caso o backend valida pela JWKS de SUPABASE_URL automaticamente.
SUPABASE_JWT_SECRET=
# Bucket de fotos das colheitas (privado)
SUPABASE_STORAGE_BUCKET=colheitas

# Fuso da operação — usado por toda a geração de escala e corte de pendência
APP_TIMEZONE=America/Fortaleza

# Motor de pendência: hora local do corte diário (formato HH:mm)
COMPLIANCE_CUTOFF_TIME=20:00
# Horário local do disparo da escala do dia
SCHEDULE_DISPATCH_TIME=06:30
# Quantos dias à frente as ocorrências da escala são materializadas
SCHEDULE_HORIZON_DAYS=14
# Liga/desliga os jobs agendados (deixe false em máquinas de desenvolvimento)
SCHEDULER_ENABLED=false

# Notificações — driver do canal de WhatsApp.
# console  = só registra no log e no banco (padrão, nada é enviado de verdade)
# webhook  = faz POST do payload num endpoint HTTP seu (Evolution API, n8n, etc.)
NOTIFICATIONS_DRIVER=console
NOTIFICATIONS_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_TOKEN=
# Não envia nada para fora quando true, mesmo com driver=webhook
NOTIFICATIONS_DRY_RUN=true

# Base pública do frontend — entra nos links das mensagens
PUBLIC_WEB_URL=http://localhost:3000

# ------------------------- apps/web (Next.js) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEUPROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3333/api
